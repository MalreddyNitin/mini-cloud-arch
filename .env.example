# Application
APP_ENV=development
APP_ORIGIN=http://localhost:5173
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=INFO
PORT=8080

# Mutations are off by default. Production requires a random >=32-character key
# when ENABLE_WRITES=true. Never expose WRITE_API_KEY in browser JavaScript.
ENABLE_WRITES=false
WRITE_API_KEY=

# PostgreSQL. Runtime should use the pooled Neon URL; migrations may use direct.
DATABASE_URL=
DATABASE_URL_DIRECT=
DB_POOL_SIZE=2
DB_MAX_OVERFLOW=0
DB_POOL_TIMEOUT=10
DB_POOL_RECYCLE=300
DB_CONNECT_TIMEOUT=5
DB_STATEMENT_TIMEOUT_MS=10000

# Cloudflare R2 (private Standard-class bucket)
R2_ENDPOINT_URL=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=
PRESIGN_EXPIRES_SECONDS=300
MAX_UPLOAD_BYTES=10485760
ALLOWED_UPLOAD_CONTENT_TYPES=image/jpeg,image/png,image/webp,application/pdf,text/plain,text/csv,application/json,application/zip

# Frontend build-time setting
VITE_API_BASE_URL=http://localhost:8080

# Google Cloud deployment defaults (not application secrets)
GCP_PROJECT_ID=
GCP_REGION=us-central1
CLOUD_RUN_SERVICE_NAME=zero-cloud-api
GCP_ARTIFACT_REPOSITORY=zero-cloud

# Optional operator-only variables used by infrastructure/usage scripts.
# Keep actual values in an untracked .env or your shell, never in this file.
CF_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CF_ANALYTICS_API_TOKEN=
