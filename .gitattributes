* text=auto

# Linux containers and CI runners require LF-terminated executable/config files.
*.sh text eol=lf
Dockerfile text eol=lf
Makefile text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.toml text eol=lf
*.py text eol=lf
*.ts text eol=lf
*.tsx text eol=lf

# Keep common binary assets out of line-ending normalization.
*.ico binary
*.jpg binary
*.jpeg binary
*.png binary
*.webp binary
